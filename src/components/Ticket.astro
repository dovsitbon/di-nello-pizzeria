---
// La carte façon ticket de commande. Données : src/data/carte.json
import carte from '../data/carte.json';
import { SITE } from '../data/site';

type Plat = { nom: string; description: string | null; prix: string | null; coupDeCoeur?: boolean };
let n = 0;
const rubriques = carte.rubriques.map((r) => ({
  ...r,
  plats: (r.plats as Plat[]).map((p) => ({ ...p, num: String(++n).padStart(2, '0') })),
}));
---
<div class="porte-ticket">
  <form class="ticket px-5 pt-9 pb-10 sm:px-9" data-ticket aria-labelledby="ticket-titre" onsubmit="return false">
    <div class="flex items-end justify-between gap-4 border-b-[3px] border-four pb-3">
      <div>
        <p class="font-titre text-[1.55rem] leading-none text-tomate">Di Nello</p>
        <h3 id="ticket-titre" class="font-texte font-bold text-[1rem] mt-1.5 tracking-[.02em]">Bon de commande</h3>
      </div>
      <div class="text-right text-[.85rem] leading-snug text-four-2" aria-hidden="true">
        <p>Table <span class="trait"></span></p>
        <p class="mt-1">Emporter <span class="case-deco"></span></p>
      </div>
    </div>
    <p class="mt-3 text-[.9rem] text-four-2">
      Prix et compositions : <span class="ac">[À CONFIRMER] carte complète à reprendre du dossier du restaurant</span>
    </p>

    {rubriques.map((r) => (
      <fieldset class="mt-8">
        <legend class="flex w-full items-baseline gap-3">
          <span class="font-titre text-[1.35rem] leading-none text-tomate">{r.titre}</span>
          {r.precision && <span class="text-[.88rem] text-four-2">{r.precision}</span>}
        </legend>
        {r.plats.length ? (
          <ul class="mt-2">
            {r.plats.map((p) => (
              <li class="ligne">
                <label class="flex items-center gap-3 min-h-[52px] py-2 cursor-pointer">
                  <input type="checkbox" class="peer sr-only" name="plat" value={p.nom} />
                  <span class="case" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d="M4 4 L20 20 M20 4 L4 20" /></svg>
                  </span>
                  <span class="num" aria-hidden="true">{p.num}</span>
                  <span class="min-w-0 flex-1">
                    <span class="nom">{p.nom}</span>
                    {p.coupDeCoeur && <span class="block text-[.86rem] font-semibold text-basilic">« Tout simplement extraordinaire », dit un avis Google</span>}
                    {p.description && <span class="block text-[.9rem] text-four-2">{p.description}</span>}
                    <span class="block mt-1 text-[.92rem] font-bold sm:hidden">{p.prix ?? <span class="ac">[À CONFIRMER] prix</span>}</span>
                  </span>
                  <span class="points" aria-hidden="true"></span>
                  <span class="prix hidden sm:block">{p.prix ?? <span class="ac">[À CONFIRMER]</span>}</span>
                </label>
              </li>
            ))}
          </ul>
        ) : (
          <p class="mt-3 border-t border-dashed border-four/30 pt-3 text-[.92rem]"><span class="ac">[À CONFIRMER] {r.vide}</span></p>
        )}
      </fieldset>
    ))}

    <div class="mt-9 border-t-[3px] border-double border-four pt-4">
      <p class="flex items-baseline justify-between gap-3 font-bold" aria-live="polite">
        <span>Plats cochés</span>
        <span class="font-titre text-[1.6rem] leading-none"><output data-compte>0</output></span>
      </p>
      <p class="mt-2 text-[.95rem] text-four-2" data-consigne>Cochez ce qui vous fait envie, appelez, lisez-nous votre ticket.</p>
      <div class="mt-4 flex flex-wrap gap-3">
        <a href={`tel:${SITE.telLien}`} class="btn btn-tomate">Appeler pour commander</a>
        <button type="reset" class="btn btn-ligne" data-effacer hidden>Effacer le ticket</button>
      </div>
    </div>
  </form>
</div>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-ticket]').forEach((f) => {
    const compte = f.querySelector('[data-compte]')!;
    const consigne = f.querySelector('[data-consigne]')!;
    const effacer = f.querySelector<HTMLButtonElement>('[data-effacer]')!;
    const base = consigne.textContent;
    const maj = () => {
      const coches = [...f.querySelectorAll<HTMLInputElement>('input[name="plat"]:checked')].map((i) => i.value);
      compte.textContent = String(coches.length);
      effacer.hidden = coches.length === 0;
      consigne.textContent = coches.length ? `Votre ticket : ${coches.join(', ')}. Appelez et lisez-le-nous.` : base;
    };
    f.addEventListener('change', maj);
    f.addEventListener('reset', () => setTimeout(maj));
  });
</script>

<style>
  .porte-ticket { filter: drop-shadow(5px 6px 0 rgb(27 23 20 / .16)); transform: rotate(.6deg); }
  .ligne { border-top: 1px dashed rgb(27 23 20 / .28); }
  .ligne:first-child { border-top: 0; }
  .case { flex: none; width: 26px; height: 26px; border: 2px solid var(--color-four); border-radius: 2px; display: grid; place-items: center; background: var(--color-mozza); }
  .case svg { width: 18px; height: 18px; fill: none; stroke: var(--color-tomate); stroke-width: 3.2; stroke-linecap: round; stroke-dasharray: 48; stroke-dashoffset: 48; transition: stroke-dashoffset .22s ease-out; }
  .peer:checked ~ .case svg { stroke-dashoffset: 0; }
  .peer:focus-visible ~ .case { outline: 3px solid var(--color-basilic); outline-offset: 3px; }
  .peer:checked ~ span .nom { color: var(--color-tomate-fonce); }
  label:hover .case { background: #fbecd0; }
  .num { flex: none; font-family: var(--font-titre); font-size: .95rem; color: var(--color-four-2); width: 1.6rem; }
  .nom { font-weight: 700; font-size: 1.08rem; line-height: 1.3; }
  .points { flex: 1 1 1.5rem; min-width: 1rem; align-self: center; border-bottom: 2px dotted rgb(27 23 20 / .35); margin-top: .6rem; max-width: 8rem; }
  .prix { flex: none; font-weight: 700; text-align: right; max-width: 9rem; }
  .trait { display: inline-block; width: 3.5rem; border-bottom: 1.5px solid currentColor; }
  .case-deco { display: inline-block; width: .9rem; height: .9rem; border: 1.5px solid currentColor; vertical-align: -2px; margin-left: .25rem; }
  @media (max-width: 639px) { .points { display: none; } }
</style>
