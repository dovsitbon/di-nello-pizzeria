---
import Logo from './Logo.astro';
import { SITE } from '../data/site';
const surAccueil = Astro.url.pathname === '/';
const lien = (ancre: string) => (surAccueil ? `#${ancre}` : `/#${ancre}`);
---
<header class="couvercle kraft relative z-20">
  <div class="wrap flex items-center justify-between gap-4 pt-3 pb-4 md:pt-4 md:pb-5">
    <a href="/" class="shrink-0 no-underline" aria-label="Pizza Di Nello, retour à l'accueil">
      <Logo />
    </a>
    <nav aria-label="Navigation principale" class="flex items-center gap-1 md:gap-2">
      <ul class="hidden lg:flex items-center gap-1 text-[1rem] font-semibold">
        <li><a class="lien-nav" href={lien('carte')}>La carte</a></li>
        <li><a class="lien-nav" href={lien('offres')}>Offres</a></li>
        <li><a class="lien-nav" href={lien('commander')}>Emporter, livraison</a></li>
        <li><a class="lien-nav" href={lien('avis')}>Avis</a></li>
        <li><a class="lien-nav" href={lien('infos')}>Horaires, accès</a></li>
      </ul>
      <span class="lg:hidden"><a class="lien-nav font-semibold" href={lien("carte")}>La carte</a></span>
      <a href={`tel:${SITE.telLien}`} class="btn btn-tomate hidden md:inline-flex ml-2 whitespace-nowrap">{SITE.telAffiche}</a>
    </nav>
  </div>
  <div class="rabat" aria-hidden="true"></div>
</header>

<style>
  .lien-nav { display: inline-flex; align-items: center; min-height: 44px; padding: 0 .75rem; text-decoration: none; border-radius: 3px; color: var(--color-four); }
  .lien-nav:hover { background: rgb(255 251 242 / .45); text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 5px; }

  /* Le rabat du couvercle : pli marqué + languette centrale */
  .rabat { position: absolute; left: 0; right: 0; bottom: -14px; height: 14px; background: var(--color-kraft-fonce); border-top: 1px solid rgb(90 60 20 / .28); box-shadow: inset 0 1px 0 rgb(255 255 255 / .25); }
  .rabat::after { content: ''; position: absolute; left: 50%; top: 13px; width: 132px; height: 14px; transform: translateX(-50%); background: var(--color-kraft-fonce); clip-path: polygon(0 0, 100% 0, 86% 100%, 14% 100%); }
  .rabat::before { content: ''; position: absolute; left: 50%; top: 4px; width: 46px; height: 18px; transform: translateX(-50%); border: 1.5px dashed rgb(90 60 20 / .45); border-top: 0; border-radius: 0 0 46px 46px; z-index: 1; }
</style>
