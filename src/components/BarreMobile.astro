---
import { SITE } from '../data/site';
---
<div class="md:hidden fixed inset-x-0 bottom-0 z-30 bg-four grid grid-cols-[1fr_auto] gap-2 px-3 pt-2.5 pb-[max(.625rem,env(safe-area-inset-bottom))]">
  <a href={`tel:${SITE.telLien}`} class="btn btn-tomate !shadow-none whitespace-nowrap !px-3">Appeler, {SITE.telAffiche}</a>
  <a href={SITE.itineraire} class="btn !border-kraft text-kraft" target="_blank" rel="noopener">Itinéraire</a>
</div>
