---
import { SITE } from '../data/site';
---
<div class="carte relative w-full min-w-0 aspect-square sm:aspect-[4/3] min-h-[300px] border-2 border-four rounded-[3px] overflow-hidden" data-carte>
  <svg class="absolute inset-0 w-full h-full" viewBox="0 0 400 300" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <rect width="400" height="300" fill="#e8dcc0" />
    <rect x="96" y="70" width="190" height="120" fill="#d9bf92" stroke="#c7a874" stroke-width="2" />
    <g fill="#f6f0e1" opacity=".9">
      <rect x="20" y="210" width="92" height="44" /><rect x="300" y="210" width="80" height="44" /><rect x="300" y="20" width="80" height="34" />
    </g>
    <path d="M-10 200 L 410 200" stroke="#fffbf2" stroke-width="18" />
    <path d="M296 -10 L 296 310" stroke="#fffbf2" stroke-width="12" />
    <text x="20" y="196" font-family="DM Sans Variable, sans-serif" font-size="12" fill="#51463c">allée des Glycines</text>
    <text x="104" y="88" font-family="DM Sans Variable, sans-serif" font-size="11" fill="#51463c">centre commercial des Vergers</text>
    <g fill="#2f6b33" opacity=".5"><circle cx="40" cy="40" r="12" /><circle cx="62" cy="52" r="9" /><circle cx="350" cy="120" r="11" /></g>
    <circle cx="205" cy="160" r="15" fill="#c3241c" /><circle cx="205" cy="160" r="6" fill="#fffbf2" />
  </svg>
  <p class="absolute left-3 top-3 right-3 sm:right-auto bg-mozza px-2.5 py-1 text-[.88rem] border border-four">{SITE.adresse.rue}, {SITE.adresse.cp} {SITE.adresse.ville}</p>
  <div class="absolute left-3 right-3 bottom-3 flex flex-wrap gap-2">
    <button type="button" class="btn bg-four text-mozza hover:bg-[#33291f]" data-charger-carte>Afficher la carte Google</button>
    <a href={SITE.itineraire} class="btn btn-ligne bg-mozza" target="_blank" rel="noopener">Itinéraire</a>
  </div>
</div>
<script>
  import { SITE } from '../data/site';
  document.querySelectorAll<HTMLElement>('[data-carte]').forEach((box) => {
    box.querySelector('[data-charger-carte]')?.addEventListener('click', () => {
      const f = document.createElement('iframe');
      f.src = SITE.carte;
      f.title = 'Carte Google : Pizza Di Nello, 8 allée des Glycines, Saint-Brice-sous-Forêt';
      f.loading = 'lazy';
      f.referrerPolicy = 'no-referrer-when-downgrade';
      f.className = 'absolute inset-0 w-full h-full border-0';
      box.replaceChildren(f);
      f.focus();
    });
  });
</script>
