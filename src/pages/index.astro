---
import Base from '../layouts/Base.astro';
import PizzaAffiche from '../components/PizzaAffiche.astro';
import Statut from '../components/Statut.astro';
import Ticket from '../components/Ticket.astro';
import Horaires from '../components/Horaires.astro';
import CarteFacade from '../components/CarteFacade.astro';
import { SITE, AVIS } from '../data/site';
import offresData from '../data/offres.json';

const offres = offresData.offres.filter((o) => o.actif);

const faq = [
  ['Êtes-vous ouverts le lundi ?', 'Non, le restaurant est fermé le lundi. Du mardi au samedi, service le midi (11h30–14h30) et le soir (18h30–22h30). Le dimanche, le soir à partir de 18h00.'],
  ['Où se garer ?', `Au centre commercial des Vergers, ${SITE.adresse.rue} à Saint-Brice-sous-Forêt : le parking est gratuit et on se gare facilement.`],
  ['Peut-on commander à emporter ?', `Oui, par téléphone au ${SITE.telAffiche}. Vous passez récupérer votre commande au restaurant.`],
  ['Livrez-vous ?', 'Oui, la livraison passe par Uber Eats. Pour la vente à emporter, appelez directement le restaurant.'],
  ['Faites-vous traiteur ?', 'Oui, le restaurant propose un service traiteur. Appelez pour en parler.'],
  ['Quels paiements acceptez-vous ?', 'Carte bancaire, y compris sans contact.'],
];
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map(([q, r]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: r } })),
};
---
<Base
  title="Pizza Di Nello, pizzeria napolitaine à Saint-Brice-sous-Forêt"
  description="Pizzas napolitaines, pâtes fraîches et tiramisu au centre commercial des Vergers, Saint-Brice-sous-Forêt. 4,9/5 sur Google. À emporter : 09 81 27 42 87."
  jsonld={[faqLd]}
>
  <!-- Affiche -->
  <section class="affiche relative overflow-hidden pt-12 md:pt-16 pb-14 md:pb-20" aria-labelledby="titre">
    <div class="wrap grid gap-10 lg:grid-cols-[1.15fr_1fr] lg:items-center [&>*]:min-w-0">
      <div class="relative z-10">
        <h1 id="titre" class="text-tomate text-[2.75rem] min-[400px]:text-[3.1rem] sm:text-[4.2rem] lg:text-[5.4rem] leading-[.95] tracking-[-.01em] max-w-[11ch]">Pizza napolitaine au centre des Vergers</h1>
        <p class="mt-6 text-[1.15rem] md:text-[1.25rem] max-w-[34rem] leading-relaxed">
          Pâte fine et légère, Mortadella à la truffe, burrata, pâtes fraîches et tiramisu. En salle, en terrasse ou à emporter, au {SITE.adresse.rue} à Saint-Brice-sous-Forêt.
        </p>

        <div class="mt-7 flex flex-wrap items-center gap-x-6 gap-y-4">
          <p class="note flex items-center gap-3">
            <span class="font-titre text-[2.6rem] leading-none">{SITE.note}<span class="text-[1.2rem]">/5</span></span>
            <span class="leading-tight">
              <span class="etoiles" aria-hidden="true">
                {[0, 1, 2, 3, 4].map(() => <svg viewBox="0 0 20 20"><path d="M10 1.5l2.6 5.6 6.1.7-4.5 4.2 1.2 6L10 15l-5.4 3 1.2-6L1.3 7.8l6.1-.7z" /></svg>)}
              </span>
              <span class="block text-[.95rem] font-semibold">{SITE.nbAvis} avis Google</span>
            </span>
          </p>
          <Statut />
        </div>

        <div class="mt-8 flex flex-wrap gap-3">
          <a href={`tel:${SITE.telLien}`} class="btn btn-tomate text-[1.08rem] !px-6">Commander à emporter</a>
          <a href="#carte" class="btn btn-ligne text-[1.08rem] !px-6">Voir la carte</a>
        </div>
        <p class="mt-3 text-[.95rem] text-four-2">Par téléphone : <a class="font-bold text-four underline underline-offset-4" href={`tel:${SITE.telLien}`}>{SITE.telAffiche}</a></p>
      </div>

      <div class="relative ml-auto -mr-10 w-[85%] max-w-[30rem] sm:mx-auto sm:w-full lg:max-w-none lg:-mr-24">
        <div class="fond-carton kraft" aria-hidden="true"></div>
        <div class="relative pizza-anim"><PizzaAffiche /></div>
        <svg viewBox="0 0 200 200" class="pastille" aria-hidden="true" focusable="false">
          <defs><path id="cercle" d="M100 100 m-74 0 a74 74 0 1 1 148 0 a74 74 0 1 1 -148 0" /></defs>
          <circle cx="100" cy="100" r="98" fill="#2f6b33" />
          <circle cx="100" cy="100" r="88" fill="none" stroke="#f6f0e1" stroke-width="2" stroke-dasharray="3 5" />
          <text font-family="Alfa Slab One, serif" font-size="21" fill="#f6f0e1" letter-spacing="2.4"><textPath href="#cercle">100 % NAPOLETANA · DI NELLO ·</textPath></text>
          <text x="100" y="96" text-anchor="middle" font-family="Alfa Slab One, serif" font-size="30" fill="#f6f0e1">95</text>
          <text x="100" y="124" text-anchor="middle" font-family="DM Sans Variable, sans-serif" font-weight="700" font-size="15" fill="#f6f0e1">Saint-Brice</text>
        </svg>
      </div>
    </div>
  </section>

  <!-- La carte -->
  <section id="carte" class="kraft-clair py-16 md:py-24 border-y-2 border-four" aria-labelledby="carte-titre">
    <div class="wrap grid gap-10 lg:grid-cols-[1fr_1.35fr] lg:gap-16">
      <div class="lg:sticky lg:top-8 lg:self-start">
        <h2 id="carte-titre" class="text-[2.6rem] md:text-[3.6rem]">La carte</h2>
        <p class="mt-5 max-w-[30rem] text-[1.1rem] leading-relaxed">
          Cochez sur le ticket ce qui vous fait envie, puis appelez le <a class="font-bold underline underline-offset-4" href={`tel:${SITE.telLien}`}>{SITE.telAffiche}</a> et lisez-nous votre commande. Vous passez la chercher, sans commission pour personne.
        </p>
        <p class="mt-4 max-w-[30rem] text-[1rem] text-four-2">Pizzas rouges, blanches et spéciales, pâtes fraîches, desserts et boissons. Ce qui est listé ici, ce sont les plats que nos clients citent le plus dans leurs avis.</p>
        <div class="photo-vide hidden lg:grid aspect-[4/3] mt-10 max-w-[26rem] border-2 border-four rounded-[3px] rotate-[-1.5deg]">
          <span>Photo à prendre : la Mortadella à la truffe vue de dessus, sur le plan de travail, lumière du jour.</span>
        </div>
      </div>
      <Ticket />
    </div>
  </section>

  <!-- Pourquoi la napolitaine -->
  <section class="py-16 md:py-24" aria-labelledby="napo-titre">
    <div class="wrap grid gap-12 lg:grid-cols-[1fr_1.5fr]">
      <div>
        <h2 id="napo-titre" class="text-[2.4rem] md:text-[3.3rem] max-w-[10ch]">Pourquoi la napolitaine</h2>
        <div class="photo-vide aspect-[4/3] lg:aspect-[4/5] mt-8 max-w-[24rem] border-2 border-four rounded-[3px]">
          <span>Photo à prendre : une pizza qui sort du four, vue de trois quarts, bords bien visibles.</span>
        </div>
      </div>
      <dl class="napo self-end">
        <div>
          <dt>La pâte</dt>
          <dd>
            <p>Fine et légère. C'est la première chose que nos clients écrivent dans leurs avis : « une pâte parfaite ».</p>
            <p class="detail">Farine et temps de fermentation : <span class="ac">[À CONFIRMER]</span></p>
          </dd>
        </div>
        <div>
          <dt>La cuisson</dt>
          <dd>
            <p>C'est elle qui fait la napolitaine : une pâte souple, des bords tachetés, une pizza qui se mange tout de suite.</p>
            <p class="detail">Type de four et temps de cuisson : <span class="ac">[À CONFIRMER]</span></p>
          </dd>
        </div>
        <div>
          <dt>Les produits</dt>
          <dd>
            <p>Mortadelle et truffe, burrata, poulet et crème, pesto. Des garnitures généreuses, avis après avis.</p>
            <p class="detail">Provenance de la tomate, de la mozzarella et de la farine : <span class="ac">[À CONFIRMER]</span></p>
          </dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- Offres du moment -->
  <section id="offres" class="kraft py-16 md:py-24 border-y-2 border-four" aria-labelledby="offres-titre">
    <div class="wrap">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <h2 id="offres-titre" class="text-[2.4rem] md:text-[3.3rem]">Offres du moment</h2>
        <p class="max-w-[26rem]">Les offres de la semaine passent d'abord sur Instagram : <a class="font-bold underline underline-offset-4" href={SITE.instagram} target="_blank" rel="noopener">{SITE.pseudo}</a>.</p>
      </div>
      <ul class="mt-12 grid gap-10 md:grid-cols-2 lg:max-w-[60rem]">
        {offres.map((o, i) => (
          <li class:list={['etiquette', i % 2 ? 'rotate-[1.4deg]' : 'rotate-[-1.6deg]']}>
            <svg class="agrafe" viewBox="0 0 60 14" aria-hidden="true"><path d="M3 11 V4 H57 V11" fill="none" stroke="#7b7268" stroke-width="3" stroke-linejoin="round" /></svg>
            <h3 class="text-[1.6rem] md:text-[1.9rem]">{o.titre}</h3>
            <p class="font-titre text-tomate text-[2.6rem] md:text-[3.2rem] leading-none mt-3">{o.prix}</p>
            {o.detail && <p class="mt-4">{o.detail}</p>}
            {o.aConfirmer && <p class="mt-4"><span class="ac">[À CONFIRMER : {o.aConfirmer}]</span></p>}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Sur place, à emporter, livraison -->
  <section id="commander" class="py-16 md:py-24" aria-labelledby="modes-titre">
    <div class="wrap">
      <h2 id="modes-titre" class="text-[2.4rem] md:text-[3.3rem] max-w-[16ch]">Sur place, à emporter ou livrée</h2>
      <div class="modes mt-10">
        <article class="mode">
          <h3>Sur place</h3>
          <p>Une salle à la déco soignée et une terrasse agréable, au centre commercial des Vergers. Les enfants sont les bienvenus.</p>
          <a href="#infos" class="lien-mode">Horaires et accès</a>
        </article>
        <article class="mode mode-direct">
          <p class="tampon tampon-vert text-[.95rem]">Commande directe</p>
          <h3>À emporter</h3>
          <p>Appelez le {SITE.telAffiche}, passez récupérer, garez-vous gratuitement. Commander en direct, c'est zéro commission : tout revient au restaurant.</p>
          <a href={`tel:${SITE.telLien}`} class="btn btn-tomate mt-1 self-start">Appeler le restaurant</a>
        </article>
        <article class="mode">
          <h3>Livraison</h3>
          <p>Possible via Uber Eats. <span class="ac">[À CONFIRMER : lien de la fiche Uber Eats et zone livrée]</span></p>
        </article>
        <article class="mode">
          <h3>Traiteur</h3>
          <p>Pour un événement ou un repas en nombre, le restaurant fait aussi traiteur. Appelez pour en parler. <span class="ac">[À CONFIRMER : formules et délais]</span></p>
        </article>
      </div>
    </div>
  </section>

  <!-- Avis -->
  <section id="avis" class="sombre bg-four text-creme py-16 md:py-24" aria-labelledby="avis-titre">
    <div class="wrap">
      <h2 id="avis-titre" class="text-[2.4rem] md:text-[3.4rem] text-kraft">{SITE.note} sur 5, {SITE.nbAvis} avis Google</h2>
      <figure class="mt-10 max-w-[56rem]">
        <blockquote class="font-titre text-[1.7rem] md:text-[2.5rem] leading-[1.12]">
          <span class="guillemet" aria-hidden="true">«</span> {AVIS[0]} <span aria-hidden="true">»</span>
        </blockquote>
        <figcaption class="mt-4 text-[.95rem] text-[#d8cfbd]">Avis Google</figcaption>
      </figure>
      <ul class="mt-14 grid gap-x-12 gap-y-10 md:grid-cols-2">
        {AVIS.slice(1).map((a) => (
          <li>
            <figure class="border-t-2 border-kraft/40 pt-5">
              <blockquote class="text-[1.15rem] md:text-[1.25rem] leading-relaxed">« {a} »</blockquote>
              <figcaption class="mt-3 text-[.92rem] text-[#d8cfbd]">Avis Google</figcaption>
            </figure>
          </li>
        ))}
      </ul>
      <p class="mt-14 max-w-[44rem] text-[1.05rem] text-[#e9e1d0]">Les habitués parlent aussi du patron, Mathiou <span class="ac">[À CONFIRMER : orthographe du prénom]</span>, et de son accueil.</p>
    </div>
  </section>

  <!-- Infos pratiques -->
  <section id="infos" class="py-16 md:py-24" aria-labelledby="infos-titre">
    <div class="wrap">
      <h2 id="infos-titre" class="text-[2.4rem] md:text-[3.3rem]">Infos pratiques</h2>
      <div class="mt-10 grid gap-12 md:grid-cols-2 xl:grid-cols-[1.15fr_.9fr_1.1fr] [&>*]:min-w-0">
        <div>
          <h3 class="text-[1.4rem] text-tomate">Horaires</h3>
          <div class="mt-4"><Horaires /></div>
          <Statut class="mt-5" />
        </div>
        <div class="grid content-start gap-7">
          <div>
            <h3 class="text-[1.4rem] text-tomate">Adresse</h3>
            <address class="not-italic mt-3 leading-relaxed">
              {SITE.nom}<br />{SITE.adresse.rue}<br />{SITE.adresse.lieu}<br />{SITE.adresse.cp} {SITE.adresse.ville}<br />
              <a class="inline-flex min-h-[44px] items-center font-bold underline underline-offset-4" href={`tel:${SITE.telLien}`}>{SITE.telAffiche}</a>
            </address>
          </div>
          <div>
            <h3 class="text-[1.4rem] text-tomate">Se garer, payer</h3>
            <p class="mt-3">Parking gratuit, stationnement facile. Carte bancaire et sans contact.</p>
          </div>
          <div>
            <h3 class="text-[1.4rem] text-tomate">Nous suivre</h3>
            <ul class="mt-2">
              <li><a class="inline-flex min-h-[44px] items-center font-semibold underline underline-offset-4" href={SITE.instagram} target="_blank" rel="noopener">Instagram {SITE.pseudo}</a></li>
              <li><a class="inline-flex min-h-[44px] items-center font-semibold underline underline-offset-4" href={SITE.tiktok} target="_blank" rel="noopener">TikTok {SITE.pseudo}</a></li>
            </ul>
          </div>
        </div>
        <div class="md:col-span-2 xl:col-span-1"><CarteFacade /></div>
      </div>

      <p class="mt-12 max-w-[50rem] text-[1.05rem] leading-relaxed">
        En septembre 2024, actu.fr citait Di Nello parmi les nouvelles enseignes qui redonnent « un second souffle » au centre commercial des Vergers. On y vient de Saint-Brice-sous-Forêt, mais aussi de {SITE.voisines.slice(0, -1).join(', ')} et {SITE.voisines.at(-1)}.
      </p>

      <div class="mt-14 max-w-[50rem]">
        <h3 class="text-[1.6rem]">Questions pratiques</h3>
        <div class="faq mt-4">
          {faq.map(([q, r]) => (
            <details>
              <summary>{q}</summary>
              <p>{r}</p>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .affiche { background-image: radial-gradient(circle at 85% 40%, rgb(217 191 146 / .35), transparent 55%); }
  .fond-carton { position: absolute; inset: 7% -4% -2% 6%; transform: rotate(-4deg); border: 2px solid rgb(90 60 20 / .25); }
  .pastille { position: absolute; width: 34%; max-width: 160px; left: -2%; bottom: -3%; transform: rotate(-12deg); }
  .etoiles { display: flex; gap: 2px; }
  .etoiles svg { width: 18px; height: 18px; fill: var(--color-tomate); }
  @media (prefers-reduced-motion: no-preference) {
    .pizza-anim { animation: pose 1.1s cubic-bezier(.2, .8, .25, 1) both; }
    @keyframes pose { from { transform: rotate(-35deg) scale(.92); opacity: 0; } to { transform: none; opacity: 1; } }
  }

  .kraft-clair { background: #efe3c8; }

  .napo > div { display: grid; gap: .5rem 2rem; padding: 1.75rem 0; border-top: 2px solid var(--color-four); }
  .napo > div:last-child { border-bottom: 2px solid var(--color-four); }
  @media (min-width: 640px) { .napo > div { grid-template-columns: 11rem 1fr; } }
  .napo dt { font-family: var(--font-titre); font-size: 1.6rem; line-height: 1.05; color: var(--color-tomate); }
  .napo dd p { font-size: 1.1rem; line-height: 1.6; max-width: 40rem; }
  .napo .detail { margin-top: .6rem; font-size: .95rem; color: var(--color-four-2); }

  .etiquette { position: relative; background: var(--color-mozza); border: 2px solid var(--color-four); padding: 2.2rem 1.6rem 1.8rem; box-shadow: 6px 7px 0 rgb(27 23 20 / .18); }
  .etiquette::before { content: ''; position: absolute; top: .9rem; right: 1rem; width: 14px; height: 14px; border-radius: 50%; border: 2px solid var(--color-four); background: var(--color-kraft); }
  .agrafe { position: absolute; top: -7px; left: 50%; width: 54px; transform: translateX(-50%) rotate(-3deg); }

  .modes { display: grid; gap: 0; border-top: 2px solid var(--color-four); }
  @media (min-width: 900px) { .modes { grid-template-columns: 1fr 1.25fr 1fr 1fr; border-top: 0; border-left: 2px solid var(--color-four); } }
  .mode { display: flex; flex-direction: column; gap: .8rem; padding: 1.75rem 0; border-bottom: 2px solid var(--color-four); }
  @media (min-width: 900px) { .mode { padding: 1.5rem 1.5rem 1.75rem; border-bottom: 0; border-right: 2px solid var(--color-four); border-top: 2px solid var(--color-four); border-bottom: 2px solid var(--color-four); } }
  .mode h3 { font-size: 1.7rem; }
  .mode-direct { background: var(--color-mozza); padding-inline: 1.25rem; margin-inline: -1.25rem; border-left: 5px solid var(--color-tomate); }
  @media (min-width: 900px) { .mode-direct { margin: -1.25rem 0; padding-top: 2.5rem; padding-bottom: 2.75rem; border: 3px solid var(--color-tomate) !important; } }
  .tampon-vert { color: var(--color-basilic); align-self: flex-start; }
  .lien-mode { display: inline-flex; align-items: center; min-height: 44px; font-weight: 700; text-decoration: underline; text-underline-offset: 4px; align-self: flex-start; }

  .guillemet { color: var(--color-tomate); }

  .faq details { border-top: 1px dashed rgb(27 23 20 / .35); }
  .faq details:last-child { border-bottom: 1px dashed rgb(27 23 20 / .35); }
  .faq summary { cursor: pointer; min-height: 52px; display: flex; align-items: center; justify-content: space-between; gap: 1rem; font-weight: 700; font-size: 1.08rem; list-style: none; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after { content: '+'; font-family: var(--font-titre); font-size: 1.5rem; color: var(--color-tomate); }
  .faq details[open] summary::after { content: '–'; }
  .faq details p { padding: 0 0 1.1rem; max-width: 42rem; }
</style>
